root = true

[*]
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.py]
indent_size = 4
max_line_length = 110

[*.sh]
indent_size = 4

[*.sql]
indent_size = 4

[*.js]
indent_size = 2

[*.ts]
indent_size = 2

[*.tsx]
indent_size = 2

[*.{md,rst}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2
max_line_length = 110

[*.{htm,html}]
indent_size = 2

[*.json]
indent_size = 4
